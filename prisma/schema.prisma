// V2 스키마: 체크리스트 항목을 "유형 하나"에서 "기능 여러 개의 조합"으로 재설계.
// 관리자가 항목 하나에 체크/횟수/점수/링크/사진제출/음성제출/영상제출/교사영상시청을
// 자유롭게 조합할 수 있도록 각 기능을 독립된 필드(플래그)로 둔다.
//
// 주의: PostgreSQL의 partial unique index(WHERE 절 포함)는 Prisma 스키마 문법으로
// 표현할 수 없으므로 아래 두 곳은 prisma/migrations/0001_init/after_prisma_migrate.sql
// 에 이미 raw SQL로 정의되어 있다:
//   - student_accounts.login_id UNIQUE WHERE account_status = 'enabled'
//   - audio_submissions UNIQUE(assigned_item_id) WHERE status = 'current'
// 이번 스키마에서 새로 추가되는 photo_submissions, video_submissions도 같은 패턴의
// partial unique index가 필요하며, 다음 배치에서 동일 파일에 추가한다.
//
// V3 추가분(활동 라이브러리): Activity 모델을 신설해 "체크박스/횟수/점수/제출 기능"과
// "관리자가 올리는 자료"를 하나의 재사용 가능한 활동 단위로 묶는다. 기존 TemplateItem의
// 기능 플래그 필드들은 과거 데이터 호환을 위해 그대로 남겨두고, activityId를 추가로
// 붙여 새 템플릿 만들기 화면부터는 활동 참조 방식을 쓴다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StudentStatus {
  active
  paused
  withdrawn
}

enum AccountStatus {
  enabled
  disabled
}

enum SubmissionStatus {
  current
  superseded
}

enum AssignmentItemStatus {
  active
  replaced
}

model Administrator {
  adminId      String   @id @default(uuid()) @map("admin_id")
  name         String
  loginId      String   @unique @map("login_id")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  sessions           AdminSession[]
  assignmentsCreated ChecklistAssignment[]
  teachingVideos     TeachingVideo[]
  shareLinksCreated  ShareLink[]
  recurringAssignmentsCreated RecurringAssignment[]

  @@map("administrators")
}

model AdminSession {
  sessionId        String    @id @default(uuid()) @map("session_id")
  adminId          String    @map("admin_id")
  admin            Administrator @relation(fields: [adminId], references: [adminId], onDelete: Cascade)
  refreshTokenHash String    @map("refresh_token_hash")
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  @@index([adminId])
  @@map("admin_sessions")
}

model Class {
  classId    String   @id @default(uuid()) @map("class_id")
  name       String
  sortOrder  Int      @default(0) @map("sort_order")
  templateId String?  @map("template_id")
  template   ChecklistTemplate? @relation(fields: [templateId], references: [templateId], onDelete: SetNull)
  createdAt  DateTime @default(now()) @map("created_at")

  students Student[]
  recurringAssignments RecurringAssignment[]

  @@map("classes")
}

model Student {
  studentId      String        @id @default(uuid()) @map("student_id")
  name           String
  studentStatus  StudentStatus @default(active) @map("student_status")
  currentClassId String?       @map("current_class_id")
  currentClass   Class?        @relation(fields: [currentClassId], references: [classId], onDelete: SetNull)
  sortOrder      Int           @default(0) @map("sort_order")
  createdAt      DateTime      @default(now()) @map("created_at")

  // 학생 개별 "고정 배정" 템플릿. 값이 있으면 반(Class.templateId)보다 우선하여
  // 매일 자동 생성되는 오늘의 체크리스트에 이 템플릿이 쓰인다. null이면 반 템플릿을 따른다.
  standingTemplateId String?            @map("standing_template_id")
  standingTemplate    ChecklistTemplate? @relation("StudentStandingTemplate", fields: [standingTemplateId], references: [templateId], onDelete: SetNull)

  account     StudentAccount?
  assignments ChecklistAssignment[]
  shareLinks  ShareLink[]
  recurringAssignments RecurringAssignment[]

  @@map("students")
}

model StudentAccount {
  accountId     String        @id @default(uuid()) @map("account_id")
  studentId     String        @unique @map("student_id")
  student       Student       @relation(fields: [studentId], references: [studentId], onDelete: Restrict)
  loginId       String        @map("login_id")
  passwordHash  String        @map("password_hash")
  accountStatus AccountStatus @default(enabled) @map("account_status")
  disabledAt    DateTime?     @map("disabled_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  sessions AuthSession[]

  @@map("student_accounts")
}

model AuthSession {
  sessionId        String    @id @default(uuid()) @map("session_id")
  accountId        String    @map("account_id")
  account          StudentAccount @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  refreshTokenHash String    @map("refresh_token_hash")
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  @@index([accountId])
  @@map("auth_sessions")
}

/// 관리자가 업로드하는 "가르치는 영상" 라이브러리 (문법 설명, 팝송 학습영상 등).
/// 학생이 제출하는 영상(VideoSubmission)과는 용도·권한이 완전히 달라 별도 테이블로 분리한다.
/// 여러 템플릿/여러 배정 항목/여러 활동에서 같은 영상을 재사용할 수 있다.
model TeachingVideo {
  videoId          String   @id @default(uuid()) @map("video_id")
  title            String
  description      String?
  fileId           String   @map("file_id")
  file             FileMetadata @relation(fields: [fileId], references: [fileId], onDelete: Restrict)
  createdByAdminId String?  @map("created_by_admin_id")
  createdByAdmin   Administrator? @relation(fields: [createdByAdminId], references: [adminId], onDelete: SetNull)
  createdAt        DateTime @default(now()) @map("created_at")

  templateItems     TemplateItem[]
  assignedItems     AssignedChecklistItem[]
  activityMaterials Activity[]

  @@map("teaching_videos")
}

/// 재사용 가능한 "활동" 라이브러리 (팝송부르기, 단어시험, 본문읽기 등).
/// 관리자가 활동을 한 번 만들어두면 여러 템플릿에서 재사용할 수 있다.
/// "학생이 해야 할 것"(제출 기능)과 "관리자가 학생에게 보여줄 자료"(참고자료)를
/// 하나의 활동 안에 함께 정의한다.
model Activity {
  activityId String   @id @default(uuid()) @map("activity_id")
  name       String
  createdAt  DateTime @default(now()) @map("created_at")

  hasCheck           Boolean @default(false) @map("has_check")
  hasCount           Boolean @default(false) @map("has_count")
  targetCount        Int?    @map("target_count")
  hasScore           Boolean @default(false) @map("has_score")
  maxScore            Int?    @map("max_score")
  hasPhotoSubmission Boolean @default(false) @map("has_photo_submission")
  hasAudioSubmission Boolean @default(false) @map("has_audio_submission")
  hasVideoSubmission Boolean @default(false) @map("has_video_submission")
  hasFileSubmission  Boolean @default(false) @map("has_file_submission")

  materialLinkUrl     String? @map("material_link_url")
  materialVideoId     String? @map("material_video_id")
  materialVideo       TeachingVideo? @relation(fields: [materialVideoId], references: [videoId], onDelete: SetNull)
  materialPhotoFileId String? @map("material_photo_file_id")
  materialPhotoFile   FileMetadata? @relation("ActivityMaterialPhoto", fields: [materialPhotoFileId], references: [fileId], onDelete: SetNull)
  materialDocFileId   String? @map("material_doc_file_id")
  materialDocFile     FileMetadata? @relation("ActivityMaterialDoc", fields: [materialDocFileId], references: [fileId], onDelete: SetNull)

  templateItems TemplateItem[]

  @@map("activities")
}

model ChecklistTemplate {
  templateId String   @id @default(uuid()) @map("template_id")
  name       String
  // 관리자가 학생들에게 보여줄 오늘의 안내문(자유 텍스트). 배정 생성 시점의 내용이
  // ChecklistAssignment.instruction에 스냅샷으로 복사되므로, 이후 안내문을 고쳐도
  // 이미 생성된 과거 배정의 안내문은 바뀌지 않는다.
  instruction String? @map("instruction")
  // 관리자가 이 템플릿(이름 또는 항목 구성)을 수정할 때마다 1씩 증가한다.
  // 이미 생성된 일일 체크리스트는 생성 당시의 버전 번호(ChecklistAssignment.templateVersion)와
  // 항목 스냅샷을 그대로 유지하므로, 이후 템플릿을 고쳐도 과거 기록은 바뀌지 않는다.
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")

  items       TemplateItem[]
  assignments ChecklistAssignment[]
  classes     Class[]
  standingStudents Student[] @relation("StudentStandingTemplate")
  recurringAssignments RecurringAssignment[]

  @@map("checklist_templates")
}

/// 템플릿 항목. 아래 "기능 플래그"들은 AssignedChecklistItem과 1:1로 동일한 구조를 가진다 —
/// 배정 시 이 필드들을 값 그대로 복사한다(진행 상태 관련 필드는 제외).
/// activityId가 있으면 새 방식(활동 라이브러리에서 담은 항목)이고, 없으면 예전 방식
/// (기능 플래그를 항목에 직접 입력)이다 — 과거 데이터 호환을 위해 두 방식 모두 유지한다.
model TemplateItem {
  templateItemId String   @id @default(uuid()) @map("template_item_id")
  templateId     String   @map("template_id")
  template       ChecklistTemplate @relation(fields: [templateId], references: [templateId], onDelete: Cascade)

  activityId String?   @map("activity_id")
  activity   Activity? @relation(fields: [activityId], references: [activityId], onDelete: SetNull)

  title          String
  sortOrder      Int      @default(0) @map("sort_order")
  isProgressItem Boolean  @default(true) @map("is_progress_item")

  // 기능 플래그 — 관리자가 항목 하나에 여러 개를 동시에 켤 수 있다. (예전 방식용, 하위 호환)
  hasCheck            Boolean @default(false) @map("has_check")
  hasCount            Boolean @default(false) @map("has_count")
  targetCount         Int?    @map("target_count")
  hasScore            Boolean @default(false) @map("has_score")
  maxScore            Int?    @map("max_score")
  linkUrl             String? @map("link_url")
  linkLabel           String? @map("link_label")
  teachingVideoId     String? @map("teaching_video_id")
  teachingVideo       TeachingVideo? @relation(fields: [teachingVideoId], references: [videoId], onDelete: SetNull)
  hasPhotoSubmission  Boolean @default(false) @map("has_photo_submission")
  hasAudioSubmission  Boolean @default(false) @map("has_audio_submission")
  hasVideoSubmission  Boolean @default(false) @map("has_video_submission")
  hasFileSubmission   Boolean @default(false) @map("has_file_submission")

  // 완료 조건에 포함할 기능들의 목록. 예: ["check","count","videoSubmission"]
  // (11번 요구사항: 단순 열람 요소인 link/teachingVideo는 이 목록에 넣지 않는 것이 기본.)
  requiredFeatures Json @default("[]") @map("required_features")

  images ImageAttachment[]

  @@map("template_items")
}

/// "반복 배정" — 관리자가 학생 1명 또는 클래스 1개에 템플릿을 연결해두면, 이 정의를
/// 근거로 매일(적용 요일에 한해) 새로운 일일 체크리스트(ChecklistAssignment)가 자동 생성된다.
/// 학생-반복배정은 서로 다른 대상(같은 학생 개별 + 그 학생이 속한 반)에 대해 동시에 여러 개
/// 존재할 수 있으며 서로 덮어쓰지 않는다 — 반 배정 위에 개별 배정이 "추가"되는 구조.
model RecurringAssignment {
  recurringAssignmentId String   @id @default(uuid()) @map("recurring_assignment_id")

  targetType String  @map("target_type") // "student" | "class"
  studentId  String? @map("student_id")
  student    Student? @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  classId    String? @map("class_id")
  class      Class?   @relation(fields: [classId], references: [classId], onDelete: Cascade)

  templateId String            @map("template_id")
  template   ChecklistTemplate @relation(fields: [templateId], references: [templateId], onDelete: Restrict)

  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  // 적용 요일. 0=일 1=월 2=화 3=수 4=목 5=금 6=토. 기본값은 매일.
  activeDays Int[] @default([0, 1, 2, 3, 4, 5, 6]) @map("active_days")

  // active: 매일 자동 생성 중 / paused: 일시정지(생성 중단, 기록은 유지) / ended: 종료
  status String @default("active") @map("status")

  // 이 반복배정에서 지금까지 생성된 일일 체크리스트 개수 — 표시용 일련번호
  // (jump1-1, jump1-2 ...)를 매기는 데 쓰인다. 절대 되돌리지 않고 계속 증가만 한다.
  sequenceCounter Int @default(0) @map("sequence_counter")

  createdByAdminId String?        @map("created_by_admin_id")
  createdByAdmin   Administrator? @relation(fields: [createdByAdminId], references: [adminId], onDelete: SetNull)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  assignments ChecklistAssignment[]

  @@index([studentId, status])
  @@index([classId, status])
  @@map("recurring_assignments")
}

model ChecklistAssignment {
  assignmentId      String   @id @default(uuid()) @map("assignment_id")
  studentId         String   @map("student_id")
  student           Student  @relation(fields: [studentId], references: [studentId], onDelete: Restrict)
  checklistDate     DateTime @map("checklist_date") @db.Date
  classIdSnapshot   String?  @map("class_id_snapshot")
  classNameSnapshot String?  @map("class_name_snapshot")
  sourceTemplateId  String?  @map("source_template_id")
  sourceTemplate    ChecklistTemplate? @relation(fields: [sourceTemplateId], references: [templateId], onDelete: SetNull)
  createdByAdminId  String?  @map("created_by_admin_id")
  createdByAdmin    Administrator? @relation(fields: [createdByAdminId], references: [adminId], onDelete: SetNull)
  createdAt         DateTime @default(now()) @map("created_at")

  // 이 배정이 "반 기본 템플릿"에서 자동 생성된 것인지("class"), 학생 "개별 고정 배정"에서
  // 자동 생성된 것인지("individual")를 구분한다. 반과 개별은 서로 덮어쓰지 않고
  // 같은 날 함께 존재할 수 있다 — 개별 배정은 "반 체크리스트에 추가로 얹는" 용도.
  // 관리자가 옛 방식으로 만든 배정이나 수동 배정은 null로 남는다.
  standingSource    String?  @map("standing_source")

  // 이 일일 체크리스트를 생성한 반복배정(RecurringAssignment). 자동 생성분에만 값이 있고,
  // 수동/레거시 배정은 null이다. (studentId, recurringAssignmentId, checklistDate) 조합에
  // 유니크 제약을 걸어 같은 반복배정이 하루에 두 번 생성되는 것을 DB 레벨에서 방지한다.
  recurringAssignmentId String?              @map("recurring_assignment_id")
  recurringAssignment    RecurringAssignment? @relation(fields: [recurringAssignmentId], references: [recurringAssignmentId], onDelete: SetNull)

  // 생성 당시 템플릿의 버전 번호 스냅샷. 이후 템플릿이 수정되어 버전이 올라가도 이 값과
  // 아래 items의 내용은 그대로 유지된다 (과거 기록 불변).
  templateVersion Int? @map("template_version")

  // 생성 당시 템플릿의 "오늘의 안내문" 스냅샷. 이후 템플릿의 안내문이 바뀌어도 이미 생성된
  // 이 배정의 안내문은 그대로 유지된다.
  instruction String? @map("instruction")

  // 표시용 일련번호 (jump1-1, jump1-2 ...) — 반복배정별로 1부터 증가. DB 식별자로는 쓰지 않는다.
  sequenceNumber Int? @map("sequence_number")

  // 기본적으로 "오늘" 날짜가 아닌 배정은 학생·관리자 모두 수정할 수 없다 (과거 기록 보존).
  // 관리자가 특정 학생의 특정 날짜 기록을 다시 열어줘야 할 때만 이 값을 true로 켠다 —
  // 켜져 있는 동안은 오늘이 아니어도 체크/점수/제출 파일을 다시 고칠 수 있다.
  reopenedForEditing Boolean @default(false) @map("reopened_for_editing")

  // true면 30일 보존기간이 지나도 자동 정리(삭제) 대상에서 제외한다. 관리자가 특별히
  // 보관해야 하는 기록을 켜둘 수 있다.
  preservedByAdmin Boolean @default(false) @map("preserved_by_admin")

  // 관리자가 학생의 그날 학습을 확인하고 "확인 완료"를 누른 시점 — 학생별 월간 캘린더에
  // 파란색으로 표시하는 기준이 된다(진행률 100%와는 별개의 "관리자 리뷰 완료" 개념).
  reviewedAt        DateTime? @map("reviewed_at")
  reviewedByAdminId String?   @map("reviewed_by_admin_id")

  items AssignedChecklistItem[]

  @@index([studentId, checklistDate])
  @@unique([studentId, recurringAssignmentId, checklistDate])
  @@map("checklist_assignments")
}

model AssignedChecklistItem {
  assignedItemId String   @id @default(uuid()) @map("assigned_item_id")
  assignmentId   String   @map("assignment_id")
  assignment     ChecklistAssignment @relation(fields: [assignmentId], references: [assignmentId], onDelete: Cascade)

  title          String
  sortOrder      Int      @default(0) @map("sort_order")
  isProgressItem Boolean  @default(true) @map("is_progress_item")
  status         AssignmentItemStatus @default(active)

  // 기능 플래그 — template_items와 동일 구조 (배정 시 값 복사).
  hasCheck           Boolean @default(false) @map("has_check")
  hasCount           Boolean @default(false) @map("has_count")
  targetCount        Int?    @map("target_count")
  hasScore           Boolean @default(false) @map("has_score")
  maxScore            Int?    @map("max_score")
  linkUrl            String? @map("link_url")
  linkLabel          String? @map("link_label")
  teachingVideoId    String? @map("teaching_video_id")
  teachingVideo      TeachingVideo? @relation(fields: [teachingVideoId], references: [videoId], onDelete: SetNull)
  hasPhotoSubmission Boolean @default(false) @map("has_photo_submission")
  hasAudioSubmission Boolean @default(false) @map("has_audio_submission")
  hasVideoSubmission Boolean @default(false) @map("has_video_submission")
  hasFileSubmission  Boolean @default(false) @map("has_file_submission")
  requiredFeatures   Json @default("[]") @map("required_features")

  // 아래부터는 "진행 상태" — 학생/관리자가 실제로 입력·제출하며 채워지는 값들.
  checked         Boolean   @default(false)
  currentCount    Int       @default(0) @map("current_count")
  score           Int?
  scoreUpdatedBy  String?   @map("score_updated_by") // 'admin' | 'student'
  scoreUpdatedAt  DateTime? @map("score_updated_at")

  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")

  images            ImageAttachment[]
  audioSubmissions  AudioSubmission[]
  photoSubmissions  PhotoSubmission[]
  videoSubmissions  VideoSubmission[]
  fileSubmissions   FileSubmission[]

  @@index([assignmentId])
  @@map("assigned_checklist_items")
}

model FileMetadata {
  fileId           String   @id @default(uuid()) @map("file_id")
  storageKey       String   @map("storage_key") // R2 object key
  originalFilename String   @map("original_filename")
  mimeType         String   @map("mime_type")
  sizeBytes        Int      @map("size_bytes")
  uploadedBy       String   @map("uploaded_by") // account_id or admin_id
  uploadedAt       DateTime @default(now()) @map("uploaded_at")

  imageAttachments       ImageAttachment[]
  audioSubmissions       AudioSubmission[]
  photoSubmissions       PhotoSubmission[]
  videoSubmissions       VideoSubmission[]
  fileSubmissions        FileSubmission[]
  teachingVideos         TeachingVideo[]
  activityMaterialPhotos Activity[] @relation("ActivityMaterialPhoto")
  activityMaterialDocs   Activity[] @relation("ActivityMaterialDoc")

  @@map("file_metadata")
}

/// 관리자가 항목에 첨부하는 학습자료 이미지(문법설명자료, 단어장 등).
/// 학생이 제출하는 사진(PhotoSubmission)과는 반대 방향이라 별도 모델로 분리.
model ImageAttachment {
  imageAttachmentId String   @id @default(uuid()) @map("image_attachment_id")

  templateItemId     String?  @map("template_item_id")
  templateItem        TemplateItem? @relation(fields: [templateItemId], references: [templateItemId], onDelete: Cascade)
  assignedItemId       String?  @map("assigned_item_id")
  assignedItem          AssignedChecklistItem? @relation(fields: [assignedItemId], references: [assignedItemId], onDelete: Cascade)

  fileId     String   @map("file_id")
  file       FileMetadata @relation(fields: [fileId], references: [fileId], onDelete: Restrict)
  sortOrder  Int      @default(0) @map("sort_order")

  @@map("image_attachments")
}

model AudioSubmission {
  submissionId    String   @id @default(uuid()) @map("submission_id")
  assignedItemId  String   @map("assigned_item_id")
  assignedItem    AssignedChecklistItem @relation(fields: [assignedItemId], references: [assignedItemId], onDelete: Cascade)
  studentId       String   @map("student_id")
  fileId          String   @map("file_id")
  file            FileMetadata @relation(fields: [fileId], references: [fileId], onDelete: Restrict)
  status          SubmissionStatus @default(current)
  durationSeconds Int?     @map("duration_seconds")
  submittedAt     DateTime @default(now()) @map("submitted_at")

  @@index([assignedItemId])
  @@map("audio_submissions")
}

/// 학생이 제출하는 시험지/숙제 사진. current/superseded 버전 관리는
/// AudioSubmission과 동일한 패턴(당일 재제출 가능, 과거 제출본은 보존).
model PhotoSubmission {
  submissionId   String   @id @default(uuid()) @map("submission_id")
  assignedItemId String   @map("assigned_item_id")
  assignedItem   AssignedChecklistItem @relation(fields: [assignedItemId], references: [assignedItemId], onDelete: Cascade)
  studentId      String   @map("student_id")
  fileId         String   @map("file_id")
  file           FileMetadata @relation(fields: [fileId], references: [fileId], onDelete: Restrict)
  status         SubmissionStatus @default(current)
  submittedAt    DateTime @default(now()) @map("submitted_at")

  @@index([assignedItemId])
  @@map("photo_submissions")
}

/// 학생이 제출하는 영상(팝송 부르기, 말하기 연습 등). 관리자가 올리는
/// TeachingVideo와는 방향이 반대이므로 완전히 다른 테이블로 분리한다.
model VideoSubmission {
  submissionId    String   @id @default(uuid()) @map("submission_id")
  assignedItemId  String   @map("assigned_item_id")
  assignedItem    AssignedChecklistItem @relation(fields: [assignedItemId], references: [assignedItemId], onDelete: Cascade)
  studentId       String   @map("student_id")
  fileId          String   @map("file_id")
  file            FileMetadata @relation(fields: [fileId], references: [fileId], onDelete: Restrict)
  status          SubmissionStatus @default(current)
  durationSeconds Int?     @map("duration_seconds")
  submittedAt     DateTime @default(now()) @map("submitted_at")

  @@index([assignedItemId])
  @@map("video_submissions")
}

/// 학생이 제출하는 범용 파일 제출("파일 제출" 아이콘). 사진/음성/영상 제출과 달리
/// 형식을 가리지 않고(이미지, PDF, 음성, 영상, 문서 등 무엇이든) 받는 용도이며,
/// 다른 제출 모델들과 동일한 current/superseded 패턴을 따른다.
model FileSubmission {
  submissionId   String   @id @default(uuid()) @map("submission_id")
  assignedItemId String   @map("assigned_item_id")
  assignedItem   AssignedChecklistItem @relation(fields: [assignedItemId], references: [assignedItemId], onDelete: Cascade)
  studentId      String   @map("student_id")
  fileId         String   @map("file_id")
  file           FileMetadata @relation(fields: [fileId], references: [fileId], onDelete: Restrict)
  status         SubmissionStatus @default(current)
  submittedAt    DateTime @default(now()) @map("submitted_at")

  @@index([assignedItemId])
  @@map("file_submissions")
}

/// 학부모 공유 링크. 로그인 없이 토큰만으로 특정 학생의 특정 날짜 학습결과를
/// 읽기 전용으로 볼 수 있게 한다(7번 요구사항). 다른 학생 정보에는 절대 접근 불가.
model ShareLink {
  shareLinkId      String    @id @default(uuid()) @map("share_link_id")
  token            String    @unique
  studentId        String    @map("student_id")
  student          Student   @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  checklistDate    DateTime  @map("checklist_date") @db.Date
  createdByAdminId String?   @map("created_by_admin_id")
  createdByAdmin   Administrator? @relation(fields: [createdByAdminId], references: [adminId], onDelete: SetNull)
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime? @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  @@index([studentId])
  @@map("share_links")
}

model IdempotencyKey {
  key          String   @id
  requestHash  String   @map("request_hash")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("idempotency_keys")
}

/// 30일 보존기간 자동 정리 실행 기록(감사 로그). 삭제된 배정은 DB에서 사라지므로,
/// "언제 누구의 어떤 날짜 기록이 왜(성공/실패) 정리됐는지"를 별도로 남겨둔다.
/// assignmentId는 삭제된 뒤에도 남아야 하므로 FK로 걸지 않는다.
model RetentionAuditLog {
  logId            String   @id @default(uuid()) @map("log_id")
  assignmentId     String   @map("assignment_id")
  studentId        String   @map("student_id")
  studentName      String   @map("student_name")
  checklistDate    DateTime @map("checklist_date") @db.Date
  status           String   @map("status") // "success" | "failed"
  deletedFileCount Int      @default(0) @map("deleted_file_count")
  detail           String?  @map("detail")
  triggeredBy      String   @map("triggered_by") // "manual" | "cron"
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([checklistDate])
  @@map("retention_audit_logs")
}
